# Environment Configuration for CampusBite

# PostgreSQL Database (Supabase, Neon, or local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusbite?schema=public"

# Authentication & Cryptography Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET="e9b25f82a9019d45a9e324c47b56d81230fb39a14d59bc4381fe4a01c38e9102"
JWT_REFRESH_SECRET="784a9e018d9f1049bc2384a59fe01c2384a14d59bc4381fe4a01c38e910238a1"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# OTP Delivery Mode (Set to true in development to log OTPs to server console for testing)
OTP_MOCK_CONSOLE="true"

# Online Payment (Razorpay / UPI Integration)
RAZORPAY_KEY_ID="rzp_test_campusbite_mock_key"
RAZORPAY_KEY_SECRET="rzp_test_campusbite_mock_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_campusbite"

# Initial Setup
ADMIN_INITIAL_PASSWORD="AdminSecurePassword2026!"
